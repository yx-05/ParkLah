# ==============================================================================
# ParkLah Backend Environment Configuration
# Target Stack: Supabase (PostgreSQL 16 + PostGIS) + Upstash (Redis 7.x)
# Region: Singapore (ap-southeast-1)
# ==============================================================================

# Server Runtime Configuration
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL + PostGIS Configuration
# ------------------------------------------------------------------------------
# In Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Use Transaction Mode (Port 6543) or Direct Session Mode (Port 5432)
# Example: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_SSL=true

# ------------------------------------------------------------------------------
# 2. Upstash Redis (Geospatial & Cache) Configuration
# ------------------------------------------------------------------------------
# In Upstash Console -> Database Details -> Connect with ioredis (TLS enabled)
# Example: rediss://default:[YOUR-PASSWORD]@[YOUR-ENDPOINT].upstash.io:6379
REDIS_URL=rediss://default:yourpassword@your-endpoint.upstash.io:6379

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Security Secrets
# ------------------------------------------------------------------------------
JWT_SECRET=parklah-super-secret-jwt-key-min-32-chars-change-in-prod
JWT_EXPIRATION=3600s
JWT_REFRESH_EXPIRATION=604800s

# ------------------------------------------------------------------------------
# 4. External Services & Providers
# ------------------------------------------------------------------------------
# Google Maps Platform API Key (Places Autocomplete, Distance Matrix, Directions)
GOOGLE_MAPS_API_KEY=AIzaSyExampleGoogleMapsKeyHere

# Telco SMS Gateway API Key (Set to "mock" for local simulated OTP)
SMS_PROVIDER=mock
SMS_API_KEY=mock-sms-api-key
